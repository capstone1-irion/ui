{
  "$defs": {
    "AnalysisResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "arion-analysis-v2",
          "default": "arion-analysis-v2",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "input_ref": {
          "$ref": "#/$defs/InputReference"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "decided_at_ms": {
          "minimum": 0,
          "title": "Decided At Ms",
          "type": "number"
        },
        "valid_until_ms": {
          "minimum": 0,
          "title": "Valid Until Ms",
          "type": "number"
        },
        "model_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "kind": {
          "default": "detector",
          "enum": [
            "detector",
            "explanation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "normal",
            "suspect",
            "unavailable",
            "warming_up",
            "explanation"
          ],
          "title": "Status",
          "type": "string"
        },
        "target": {
          "default": "powertrain",
          "maxLength": 80,
          "title": "Target",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 6000,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceV2"
          },
          "maxItems": 64,
          "title": "Evidence",
          "type": "array"
        },
        "related_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Related Event Ids",
          "type": "array"
        },
        "origin": {
          "default": "model",
          "enum": [
            "model",
            "fixture"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "provider_id",
        "run_id",
        "input_ref",
        "epoch",
        "start_ms",
        "end_ms",
        "decided_at_ms",
        "valid_until_ms",
        "model_version",
        "status",
        "title"
      ],
      "title": "AnalysisResult",
      "type": "object"
    },
    "EvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "signal": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Signal",
          "type": "string"
        },
        "unit": {
          "maxLength": 30,
          "title": "Unit",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "predicted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted"
        },
        "residual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "note": {
          "default": "",
          "maxLength": 500,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "unit"
      ],
      "title": "EvidenceV2",
      "type": "object"
    },
    "InputReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "file",
            "stream"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "start_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Sequence"
        },
        "end_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Sequence"
        },
        "segment_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Sha256"
        },
        "preprocess_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preprocess Version"
        }
      },
      "required": [
        "kind"
      ],
      "title": "InputReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "arion-provider-results-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "ready",
        "warming_up",
        "unavailable"
      ],
      "title": "State",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/AnalysisResult"
      },
      "maxItems": 2000,
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "provider_id",
    "run_id",
    "state"
  ],
  "title": "AnalysisResponse",
  "type": "object"
}
